# Required for live SEC EDGAR requests. Tests do not need this.
# SEC fair-access policy requires an identifying User-Agent with contact email.
FILINGEDGE_SEC_EMAIL=

# Optional organization name used in the User-Agent string.
FILINGEDGE_SEC_ORGANIZATION=FilingEdge

# DuckDB database path (created on init-db / first ingest).
FILINGEDGE_DATABASE_PATH=data/filingedge.duckdb

# Optional HTTP response cache directory.
FILINGEDGE_CACHE_DIR=data/cache

# Request timeout in seconds.
FILINGEDGE_HTTP_TIMEOUT_SECONDS=30

# Max requests per second (must stay below 10 per SEC guidance).
FILINGEDGE_MAX_REQUESTS_PER_SECOND=8
